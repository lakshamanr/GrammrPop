<Window x:Class="GrammrPop.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="GrammrPop - Grammar Assistant"
        Width="680"
        Height="580"
        MinHeight="450"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Compact Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.12" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Compact Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="75"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Header with Icon -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="✨" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Grammar Assistant"
                             FontSize="15"
                             FontWeight="Bold"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Paste or type your text below"
                             FontSize="10"
                             Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                             Margin="0,2,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grammar Mode Toggle -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                         Text="Grammar Engine" 
                         FontWeight="SemiBold"
                         FontSize="12"
                         Margin="0,0,0,8"/>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="LanguageToolButton"
                               Content="LanguageTool"
                               GroupName="GrammarEngine"
                               Click="LanguageToolButton_Click"
                               IsChecked="True"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,4"/>

                    <RadioButton x:Name="BothButton"
                               Content="Both"
                               GroupName="GrammarEngine"
                               Click="BothButton_Click"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,4"/>

                    <RadioButton x:Name="OllamaButton"
                               Content="Ollama (AI)"
                               GroupName="GrammarEngine"
                               Click="OllamaButton_Click"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4"/>

                    <Border x:Name="OllamaWarningText"
                          Background="{StaticResource WarningBrush}"
                          CornerRadius="3"
                          Padding="5,3"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          Margin="0,0,0,4">
                        <TextBlock Text="⚠ Not running"
                                 Foreground="White"
                                 FontSize="9"
                                 FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Input TextBox Card -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                         Text="Your Text"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Margin="0,0,0,6"/>

                <TextBox x:Name="InputTextBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       BorderThickness="1"
                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       Padding="8,6"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       MinHeight="100"
                       MaxHeight="200"
                       VerticalAlignment="Stretch"
                       ui:ControlHelper.CornerRadius="4"
                       ui:ControlHelper.PlaceholderText="Type or paste text here..."/>
            </DockPanel>
        </Border>

        <!-- Check Button -->
        <Button Grid.Row="3"
                Content="🔍 Check Grammar"
                Click="CheckButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                FontSize="13"
                Height="36"
                Margin="0,0,0,8"/>

        <!-- Suggestions Card -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                         Text="Suggestions"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Margin="0,0,0,6"/>

                <Border Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                      CornerRadius="4"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <Grid>
                        <TextBlock x:Name="NoSuggestionsText"
                                 Text="No suggestions yet. Click 'Check Grammar'."
                                 Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                 FontStyle="Italic"
                                 FontSize="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 Margin="16"
                                 Visibility="Visible"/>

                        <ScrollViewer x:Name="SuggestionsScrollViewer"
                                    Visibility="Collapsed"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    MaxHeight="180">
                            <ListView x:Name="SuggestionsListView"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Padding="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                              CornerRadius="4"
                                              Padding="8"
                                              Margin="2,2,2,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                        IsChecked="{Binding Accepted}"
                                                        VerticalAlignment="Top"
                                                        Margin="0,3,10,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock TextWrapping="Wrap"
                                                             FontWeight="SemiBold"
                                                             FontSize="12"
                                                             Margin="0,0,0,4">
                                                        <Run Text="{Binding ErrorText}"
                                                           Foreground="{StaticResource ErrorBrush}"
                                                           TextDecorations="Strikethrough"/>
                                                        <Run Text=" → " Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"/>
                                                        <Run Text="{Binding SuggestedReplacement}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontWeight="Bold"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}"
                                                             TextWrapping="Wrap"
                                                             Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                                             FontSize="10"
                                                             LineHeight="14"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Action Buttons - Responsive Wrap Panel -->
        <WrapPanel Grid.Row="5"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right">
            <Button Content="✅ Apply Selected"
                  Click="ApplySelectedButton_Click"
                  Style="{StaticResource ActionButtonStyle}"
                  Background="{StaticResource SuccessBrush}"
                  BorderBrush="{StaticResource SuccessBrush}"
                  Margin="0,0,6,4"/>
            <Button Content="✅ Apply All"
                  Click="ApplyAllButton_Click"
                  Style="{StaticResource ActionButtonStyle}"
                  Background="{StaticResource SuccessBrush}"
                  BorderBrush="{StaticResource SuccessBrush}"
                  Margin="0,0,6,4"/>
            <Button Content="📋 Copy"
                  Click="CopyButton_Click"
                  Style="{StaticResource ActionButtonStyle}"
                  Margin="0,0,6,4"/>
            <Button Content="⚙️ Settings"
                  Click="SettingsButton_Click"
                  Style="{StaticResource ActionButtonStyle}"
                  Margin="0,0,6,4"/>
            <Button Content="❌ Close"
                  Click="CloseButton_Click"
                  Style="{StaticResource ActionButtonStyle}"
                  Margin="0,0,0,4"/>
        </WrapPanel>

        <!-- Modern Loading Overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="6"
                Background="#CC000000"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True"
                               Width="50"
                               Height="50"
                               Margin="0,0,0,12"/>
                <TextBlock Text="Checking grammar..."
                         Foreground="White"
                         FontSize="15"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
                <TextBlock Text="Please wait..."
                         Foreground="#CCFFFFFF"
                         FontSize="11"
                         HorizontalAlignment="Center"
                         Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
