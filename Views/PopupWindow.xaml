<Window x:Class="GrammrPop.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="GrammrPop - Grammar Assistant"
        Width="750"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.15" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Icon -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✨" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Grammar Assistant"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Paste or type your text below for grammar checking"
                             FontSize="12"
                             Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grammar Mode Toggle -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Grammar Engine" 
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LanguageToolButton"
                               Content="LanguageTool"
                               GroupName="GrammarEngine"
                               Click="LanguageToolButton_Click"
                               IsChecked="True"
                               Margin="0,0,16,0"/>

                    <RadioButton x:Name="BothButton"
                               Content="Both (Comprehensive)"
                               GroupName="GrammarEngine"
                               Click="BothButton_Click"
                               Margin="0,0,16,0"/>

                    <RadioButton x:Name="OllamaButton"
                               Content="Ollama (AI)"
                               GroupName="GrammarEngine"
                               Click="OllamaButton_Click"
                               Margin="0,0,16,0"/>

                    <Border x:Name="OllamaWarningText"
                          Background="{StaticResource WarningBrush}"
                          CornerRadius="4"
                          Padding="8,4"
                          Visibility="Collapsed"
                          VerticalAlignment="Center">
                        <TextBlock Text="⚠ Ollama not running"
                                 Foreground="White"
                                 FontSize="11"
                                 FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Input TextBox Card -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                         Text="Your Text"
                         FontWeight="SemiBold"
                         Margin="0,0,0,12"/>

                <TextBox Grid.Row="1"
                       x:Name="InputTextBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       BorderThickness="1"
                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                       Padding="12"
                       FontSize="14"
                       FontFamily="Segoe UI"
                       ui:ControlHelper.CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Check Button -->
        <Button Grid.Row="3"
                Content="🔍 Check Grammar"
                Click="CheckButton_Click"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                FontSize="15"
                Height="44"
                Margin="0,0,0,16"/>

        <!-- Suggestions Card -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                         Text="Suggestions"
                         FontWeight="SemiBold"
                         Margin="0,0,0,12"/>

                <Border Grid.Row="1"
                      Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                      CornerRadius="6"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                    <Grid>
                        <TextBlock x:Name="NoSuggestionsText"
                                 Text="No suggestions yet. Click 'Check Grammar' to analyze your text."
                                 Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                 FontStyle="Italic"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Margin="24"
                                 Visibility="Visible"/>

                        <ListView x:Name="SuggestionsListView"
                                Visibility="Collapsed"
                                BorderThickness="0"
                                Background="Transparent"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                          CornerRadius="6"
                                          Padding="12"
                                          Margin="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                    IsChecked="{Binding Accepted}"
                                                    VerticalAlignment="Top"
                                                    Margin="0,4,12,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock TextWrapping="Wrap"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,0,6">
                                                    <Run Text="{Binding ErrorText}"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       TextDecorations="Strikethrough"/>
                                                    <Run Text=" → " Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"/>
                                                    <Run Text="{Binding SuggestedReplacement}"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}"
                                                         TextWrapping="Wrap"
                                                         Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                                         FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <ui:SimpleStackPanel Grid.Row="5"
                           Orientation="Horizontal"
                           Spacing="12"
                           HorizontalAlignment="Right">
            <Button Content="✅ Apply Selected"
                  Click="ApplySelectedButton_Click"
                  Style="{StaticResource AccentButtonStyle}"
                  Background="{StaticResource SuccessBrush}"
                  BorderBrush="{StaticResource SuccessBrush}"/>
            <Button Content="✅ Apply All"
                  Click="ApplyAllButton_Click"
                  Style="{StaticResource AccentButtonStyle}"
                  Background="{StaticResource SuccessBrush}"
                  BorderBrush="{StaticResource SuccessBrush}"/>
            <Button Content="📋 Copy"
                  Click="CopyButton_Click"
                  Padding="20,10"/>
            <Button Content="⚙️ Settings"
                  Click="SettingsButton_Click"
                  Padding="20,10"/>
            <Button Content="❌ Close"
                  Click="CloseButton_Click"
                  Padding="20,10"/>
        </ui:SimpleStackPanel>

        <!-- Modern Loading Overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Grid.RowSpan="6"
                Background="#CC000000"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <ui:ProgressRing IsActive="True"
                               Width="60"
                               Height="60"
                               Margin="0,0,0,16"/>
                <TextBlock Text="Checking grammar..."
                         Foreground="White"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
                <TextBlock Text="This may take a few moments"
                         Foreground="#CCFFFFFF"
                         FontSize="12"
                         HorizontalAlignment="Center"
                         Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
