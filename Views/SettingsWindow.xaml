<Window x:Class="GrammrPop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="GrammrPop - Settings"
        Width="700"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlPageTextBaseMediumBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="⚙️ Settings"
                         FontSize="28"
                         FontWeight="Bold"/>
                <TextBlock Text="Configure your grammar checking preferences"
                         FontSize="14"
                         Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                         Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Settings Cards -->
            <StackPanel Grid.Row="1">

                <!-- Hotkey Card -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="⌨️ Global Hotkey" Style="{StaticResource CardHeaderStyle}"/>

                        <TextBlock Text="Keyboard Shortcut" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBox x:Name="HotkeyTextBox"
                               ui:ControlHelper.PlaceholderText="e.g. Ctrl+Shift+G"
                               ui:ControlHelper.CornerRadius="6"
                               Padding="12,8"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource HintTextStyle}">
                            <Run Text="💡"/>
                            <Run Text="Supported formats: Ctrl+Alt+G, Ctrl+Shift+H, Win+G, etc."/>
                            <LineBreak/>
                            <Run Text="⚠️" Foreground="{StaticResource WarningBrush}"/>
                            <Run Text="If the hotkey is already in use, you'll see an error on startup." 
                                 Foreground="{StaticResource WarningBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Language Card -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🌍 Language" Style="{StaticResource CardHeaderStyle}"/>

                        <TextBlock Text="Checking Language" Style="{StaticResource SettingLabelStyle}"/>
                        <ComboBox x:Name="LanguageComboBox"
                                ui:ControlHelper.CornerRadius="6"
                                Padding="12,8"
                                FontSize="14"
                                Margin="0,0,0,8">
                            <ComboBoxItem Content="English (US)" Tag="en-US"/>
                            <ComboBoxItem Content="English (GB)" Tag="en-GB"/>
                            <ComboBoxItem Content="German" Tag="de-DE"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Dutch" Tag="nl"/>
                        </ComboBox>

                        <TextBlock Text="💡 Select the language you want to check"
                                 Style="{StaticResource HintTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- API Settings Card -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔌 Grammar Service" Style="{StaticResource CardHeaderStyle}"/>

                        <CheckBox x:Name="UseLocalServerCheckBox"
                                Content="Use Local Server (Privacy Mode)"
                                Margin="0,0,0,16"
                                Checked="UseLocalServerCheckBox_CheckedChanged"
                                Unchecked="UseLocalServerCheckBox_CheckedChanged"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                        <TextBlock Text="API Endpoint" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBox x:Name="ApiEndpointTextBox"
                               ui:ControlHelper.PlaceholderText="https://api.languagetool.org"
                               ui:ControlHelper.CornerRadius="6"
                               Padding="12,8"
                               FontSize="13"
                               FontFamily="Consolas"
                               Margin="0,0,0,12"/>

                        <TextBlock Text="API Key (Optional)" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBox x:Name="ApiKeyTextBox"
                               ui:ControlHelper.PlaceholderText="Leave empty for public API"
                               ui:ControlHelper.CornerRadius="6"
                               Padding="12,8"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource HintTextStyle}">
                            <Run Text="💡"/>
                            <Run Text="Public API is free but rate-limited. For unlimited usage, use local server or get an API key."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Features Card -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="✨ Features" Style="{StaticResource CardHeaderStyle}"/>

                        <CheckBox x:Name="AutoPasteCheckBox"
                                Content="Auto-Paste Corrections"
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                        <TextBlock Text="💡 Automatically paste corrected text back using Ctrl+V"
                                 Style="{StaticResource HintTextStyle}"/>

                        <CheckBox x:Name="EnableAutoDetectCheckBox"
                                Content="Smart Detection (Grammarly-like)"
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            <Run Text="💡"/>
                            <Run Text="Show floating icon on text fields automatically."/>
                            <LineBreak/>
                            <Run Text="⚠️" Foreground="{StaticResource WarningBrush}"/>
                            <Run Text="May increase CPU usage slightly." Foreground="{StaticResource WarningBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- History Card -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="📜 History" Style="{StaticResource CardHeaderStyle}"/>

                        <TextBlock Text="Keep Last" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBox x:Name="HistorySizeTextBox"
                               ui:ControlHelper.PlaceholderText="50"
                               ui:ControlHelper.CornerRadius="6"
                               Padding="12,8"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                        <TextBlock Text="💡 Number of recent grammar checks to keep in history"
                                 Style="{StaticResource HintTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Info Card -->
                <Border Background="{DynamicResource SystemControlAcrylicElementBrush}"
                      CornerRadius="8"
                      Padding="20"
                      BorderThickness="2"
                      BorderBrush="{StaticResource PrimaryBrush}"
                      Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ℹ️ About GrammrPop"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20">
                            <Run Text="GrammrPop is a lightweight grammar assistant powered by LanguageTool and Ollama AI."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="🔗 Public API: " FontWeight="SemiBold"/>
                            <Run Text="https://api.languagetool.org" FontFamily="Consolas" FontSize="11"/>
                            <LineBreak/>
                            <Run Text="🔒 For privacy, run a local LanguageTool server or Ollama."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="✨ New: WordPad support, Electron apps, and stable settings!" 
                                 FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Action Buttons -->
            <ui:SimpleStackPanel Grid.Row="2"
                               Orientation="Horizontal"
                               Spacing="12"
                               HorizontalAlignment="Right"
                               Margin="0,24,0,0">
                <Button Content="💾 Save Settings"
                      Click="SaveButton_Click"
                      Style="{StaticResource AccentButtonStyle}"
                      Padding="24,12"
                      FontSize="15"
                      FontWeight="SemiBold"/>
                <Button Content="❌ Cancel"
                      Click="CancelButton_Click"
                      Padding="24,12"
                      FontSize="15"/>
            </ui:SimpleStackPanel>

        </Grid>
    </ScrollViewer>
</Window>
