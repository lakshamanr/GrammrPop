<Window x:Class="GrammrPop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrammrPop - Settings"
        Width="600"
        Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1">

                <!-- Hotkey Section -->
                <TextBlock Text="Global Hotkey"
                          Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Current hotkey: Ctrl+Alt+G (configurable in future version)"
                          Foreground="#666666"
                          Margin="0,0,0,4"/>
                <TextBox x:Name="HotkeyTextBox"
                        Style="{StaticResource InputStyle}"
                        IsReadOnly="True"
                        Background="#E0E0E0"
                        Margin="0,0,0,8"/>

                <!-- Language Section -->
                <TextBlock Text="Language"
                          Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="LanguageComboBox"
                         MinHeight="32"
                         Margin="0,0,0,8">
                    <ComboBoxItem Content="English (US)" Tag="en-US"/>
                    <ComboBoxItem Content="English (GB)" Tag="en-GB"/>
                    <ComboBoxItem Content="German" Tag="de-DE"/>
                    <ComboBoxItem Content="French" Tag="fr"/>
                    <ComboBoxItem Content="Spanish" Tag="es"/>
                    <ComboBoxItem Content="Portuguese" Tag="pt"/>
                    <ComboBoxItem Content="Italian" Tag="it"/>
                    <ComboBoxItem Content="Dutch" Tag="nl"/>
                </ComboBox>

                <!-- API Settings Section -->
                <TextBlock Text="Grammar Service"
                          Style="{StaticResource SectionHeaderStyle}"/>

                <CheckBox x:Name="UseLocalServerCheckBox"
                         Content="Use local LanguageTool server (privacy mode)"
                         Margin="0,4,0,12"
                         Checked="UseLocalServerCheckBox_CheckedChanged"
                         Unchecked="UseLocalServerCheckBox_CheckedChanged"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                              Text="API Endpoint:"
                              Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                            x:Name="ApiEndpointTextBox"
                            Style="{StaticResource InputStyle}"
                            Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                              Text="API Key:"
                              Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                            x:Name="ApiKeyTextBox"
                            Style="{StaticResource InputStyle}"
                            Margin="0,0,0,8"/>
                </Grid>

                <TextBlock Text="Leave API Key empty for free public service (rate limited)"
                          Foreground="#666666"
                          FontSize="11"
                          Margin="0,0,0,8"
                          TextWrapping="Wrap"/>

                <!-- Auto-Paste Section -->
                <TextBlock Text="Clipboard &amp; Auto-Paste"
                          Style="{StaticResource SectionHeaderStyle}"/>

                <CheckBox x:Name="AutoPasteCheckBox"
                         Content="Automatically paste corrected text back to previous window"
                         Margin="0,4,0,4"/>

                <TextBlock Text="When enabled, corrected text will be pasted back using Ctrl+V"
                          Foreground="#666666"
                          FontSize="11"
                          Margin="0,0,0,16"
                          TextWrapping="Wrap"/>

                <!-- History Section -->
                <TextBlock Text="History"
                          Style="{StaticResource SectionHeaderStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                              Text="Keep last:"
                              Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1"
                            x:Name="HistorySizeTextBox"
                            Style="{StaticResource InputStyle}"
                            Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2"
                              Text="checked texts"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Info Section -->
                <Border Background="#E3F2FD"
                       BorderBrush="#2196F3"
                       BorderThickness="1"
                       CornerRadius="4"
                       Padding="12"
                       Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️ About GrammrPop"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap"
                                  FontSize="12">
                            <Run Text="GrammrPop is a lightweight grammar assistant that uses LanguageTool to check your writing."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Public API: "/>
                            <Run FontFamily="Consolas" FontSize="11">https://api.languagetool.org</Run>
                            <LineBreak/>
                            <Run Text="For privacy, you can run a local LanguageTool server."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Margin="0,16,0,0">
                <Button Content="Save"
                       Click="SaveButton_Click"
                       Padding="20,8"
                       MinWidth="100"
                       Background="#4CAF50"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0"
                       Cursor="Hand"/>
                <Button Content="Cancel"
                       Click="CancelButton_Click"
                       Padding="20,8"
                       MinWidth="100"
                       Background="#9E9E9E"
                       Foreground="White"
                       BorderThickness="0"
                       FontWeight="SemiBold"
                       Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
