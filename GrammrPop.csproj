<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>GrammrPop</AssemblyName>
    <RootNamespace>GrammrPop</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>GrammrPop Team</Authors>
    <Product>GrammrPop</Product>
    <Description>Lightweight global grammar popup assistant for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NHotkey.Wpf" Version="3.0.0" />
    <PackageReference Include="InputSimulator" Version="1.0.4" />
  </ItemGroup>

</Project>
